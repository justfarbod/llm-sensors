# Published by this project's GitLab CI pipeline.
OPEN_WEBUI_IMAGE=gitlab.uni-marburg.de:5050/fb12/ag-becker/theses/practical_2026_llm-sensors:latest
OPEN_WEBUI_PORT=3000

# Ollama runs outside Docker on the same host by default.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ./setup-university.sh generates this value on first run.
WEBUI_SECRET_KEY=

# Opt in only after reading the telemetry disclosure and installing the extension.
EXPERIMENT_TELEMETRY_EXTENSION_ENABLED=false
EXPERIMENT_TELEMETRY_EXTENSION_ORIGIN=http://localhost:3000
EXPERIMENT_TELEMETRY_EXTENSION_ID=
EXPERIMENT_TELEMETRY_EXTENSION_STORE_URL=
EXPERIMENT_TELEMETRY_EXTENSION_MIN_VERSION=2.0.0
